<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View for Services -->
    <record id="view_wasm_service_form" model="ir.ui.view">
        <field name="name">wasm.service.form</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <form string="الخدمة الإنشائية - عرفة الهندسية">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" style="max-width: 120px; max-height: 120px;"/>
                    <div class="oe_title">
                        <label for="name" string="اسم الخدمة الإنشائية"/>
                        <h1><field name="name" placeholder="مثال: الأعمال الكهروميكانيكية MEP"/></h1>
                    </div>
                    <group>
                        <group string="تصنيف الخدمة والأيقونة">
                            <field name="category"/>
                            <field name="icon" placeholder="مثال: fa-cogs أو fa-bolt"/>
                        </group>
                        <group string="الترتيب والحالة">
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الوصف المختصر (يظهر في الكروت)" name="desc">
                            <field name="short_description" placeholder="اكتب وصفاً موجزاً يظهر في كارت الخدمة بالصفحة الرئيسية والخدمات..."/>
                        </page>
                        <page string="الشرح المفصل ونطاق العمل" name="details">
                            <field name="detailed_description" placeholder="تفاصيل الخدمة الشاملة ومعايير التنفيذ وفق الكود السعودي..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View for Services (Click row to open Form view) -->
    <record id="view_wasm_service_tree" model="ir.ui.view">
        <field name="name">wasm.service.tree</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <list string="الخدمات الإنشائية">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="category"/>
                <field name="icon"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban View for Services -->
    <record id="view_wasm_service_kanban" model="ir.ui.view">
        <field name="name">wasm.service.kanban</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center p-2 gap-3">
                            <field name="image" widget="image" style="width: 70px; height: 70px; object-fit: cover;" class="rounded shadow-sm"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-6 mb-1 text-dark">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted small mb-2">
                                    <field name="category"/>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-light text-dark border">
                                        <field name="icon"/>
                                    </span>
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View for Services -->
    <record id="view_wasm_service_search" model="ir.ui.view">
        <field name="name">wasm.service.search</field>
        <field name="model">wasm.service</field>
        <field name="arch" type="xml">
            <search string="البحث في الخدمات">
                <field name="name"/>
                <field name="category"/>
                <filter string="أرشيف" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_wasm_service" model="ir.actions.act_window">
        <field name="name">الخدمات الإنشائية - عرفة الهندسية</field>
        <field name="res_model">wasm.service</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_wasm_service_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة خدمة إنشائية جديدة لشركة عرفة الهندسية
            </p>
            <p>
                يمكنك إضافة وتحديث ونشر الخدمات الإنشائية لتظهر فوراً في واجهة الموقع ومعرض الخدمات.
            </p>
        </field>
    </record>

</odoo>
