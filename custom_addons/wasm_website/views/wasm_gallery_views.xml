<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View -->
    <record id="view_wasm_gallery_tree" model="ir.ui.view">
        <field name="name">wasm.gallery.image.tree</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <list string="معرض الصور والوسائط">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="project_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_wasm_gallery_form" model="ir.ui.view">
        <field name="name">wasm.gallery.image.form</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <form string="تفاصيل صورة المعرض">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [150, 150]}"/>
                    <div class="oe_title">
                        <label for="name" string="عنوان الصورة / الوصف المختصر"/>
                        <h1>
                            <field name="name" placeholder="مثال: تركيب شبكة الغازات الطبية في مستشفى..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View with Image Thumbnails -->
    <record id="view_wasm_gallery_kanban" model="ir.ui.view">
        <field name="name">wasm.gallery.image.kanban</field>
        <field name="model">wasm.gallery.image</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden p-2 text-center">
                            <field name="image" widget="image" options="{'size': [180, 130]}" class="rounded-3 mx-auto mb-2"/>
                            <h6 class="fw-bold mb-1"><field name="name"/></h6>
                            <span class="badge bg-warning text-dark"><field name="category"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wasm_gallery" model="ir.actions.act_window">
        <field name="name">معرض الصور والوسائط</field>
        <field name="res_model">wasm.gallery.image</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة صور وتنفيذات ميدانية جديدة لمعرض الوسائط بالموقع
            </p>
        </field>
    </record>
</odoo>
